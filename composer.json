{
    "name": "roundly-consulting/options-for-laravel",
    "description": "Manage global or per-entity options and preferences with typed casts and in-request caching.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "options",
        "settings",
        "preferences"
    ],
    "homepage": "https://github.com/roundly-consulting/options-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../package-toolkit-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/package-toolkit-for-laravel",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/package-toolkit-for-laravel": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Options\\": "src",
            "RoundlyConsulting\\Options\\Database\\Factories\\": "database/factories"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Options\\Tests\\": "tests"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Options\\OptionsServiceProvider"
            ],
            "aliases": {
                "Options": "RoundlyConsulting\\Options\\Facades\\Options"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
